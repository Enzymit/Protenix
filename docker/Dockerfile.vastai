# syntax=docker/dockerfile:1
ARG RUNTIME_IMAGE=vastai/base-image:cuda-12.4.1-auto

FROM mambaorg/micromamba:1.5.8 AS protenix-env

USER root
ENV MAMBA_ROOT_PREFIX=/opt/conda \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN micromamba create -y -n protenix -c conda-forge python=3.11 pip \
 && micromamba clean -a -y

ENV PATH="/opt/conda/envs/protenix/bin:${PATH}"

WORKDIR /tmp/protenix-src
COPY setup.py README.md LICENSE requirements.txt ./
COPY configs ./configs
COPY protenix ./protenix
COPY runner ./runner

RUN python -m pip install --upgrade pip setuptools wheel -i https://pypi.org/simple \
 && python -m pip install -i https://pypi.org/simple \
        torch==2.7.1 \
        cuequivariance-ops-torch-cu12==0.8.0 \
        cuequivariance-torch==0.8.0 \
        "scipy>=1.9.0" \
        ml_collections==1.1.0 \
        tqdm==4.67.1 \
        pandas==2.3.1 \
        PyYAML==6.0.2 \
        rdkit==2025.9.3 \
        biopython==1.85 \
        biotite==1.4.0 \
        fair-esm==2.0.0 \
        scikit-learn==1.7.1 \
        "pydantic>=2.0.0" \
        triton==3.3.1 \
        optree==0.17.0 \
        protobuf==6.31.1 \
        numpy==2.4.1 \
        "networkx>=3.4.2" \
        click \
        requests \
 && python -m pip install --no-deps . -i https://pypi.org/simple \
 && find /opt/conda/envs/protenix -type d -name "__pycache__" -prune -exec rm -rf {} + \
 && find /opt/conda/envs/protenix -type f \( -name "*.pyc" -o -name "*.pyo" -o -name "*.a" \) -delete \
 && rm -rf /root/.cache /tmp/*

FROM ${RUNTIME_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PROTENIX_ENV=/opt/conda/envs/protenix \
    PROTENIX_ROOT_DIR=/opt/protenix_data \
    LAYERNORM_TYPE=torch \
    PROTENIX_CUDA_LIBS="/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cuda_cupti/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cudnn/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cufft/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cufile/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/curand/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cusolver/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cusparse/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/cusparselt/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/nccl/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/nvjitlink/lib:/opt/conda/envs/protenix/lib/python3.11/site-packages/nvidia/nvtx/lib:/opt/conda/envs/protenix/lib"

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        hmmer \
        kalign \
        libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=protenix-env /opt/conda/envs/protenix /opt/conda/envs/protenix

RUN { \
        echo '#!/usr/bin/env bash'; \
        echo 'set -e'; \
        echo 'export LD_LIBRARY_PATH="${PROTENIX_CUDA_LIBS}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"'; \
        echo 'exec /opt/conda/envs/protenix/bin/protenix "$@"'; \
    } > /usr/local/bin/protenix \
 && chmod +x /usr/local/bin/protenix

RUN --mount=type=bind,from=protenix_weights,source=/,target=/tmp/protenix_weights,ro \
    mkdir -p "${PROTENIX_ROOT_DIR}/checkpoint" "${PROTENIX_ROOT_DIR}/common" /workspace \
 && cp /tmp/protenix_weights/checkpoint/protenix-v2.pt "${PROTENIX_ROOT_DIR}/checkpoint/protenix-v2.pt" \
 && cp -a /tmp/protenix_weights/common/. "${PROTENIX_ROOT_DIR}/common/"

RUN ln -sfn "${PROTENIX_ROOT_DIR}/checkpoint" /root/checkpoint \
 && ln -sfn "${PROTENIX_ROOT_DIR}/common" /root/common \
 && printf 'PROTENIX_ROOT_DIR=%s\nLAYERNORM_TYPE=torch\n' "${PROTENIX_ROOT_DIR}" >> /etc/environment

RUN protenix --help >/dev/null \
 && /opt/conda/envs/protenix/bin/python -c "import importlib.util; import torch; from rdkit import Chem; import biotite; import sklearn; import triton; import esm; from runner.batch_inference import protenix_cli; from protenix.data.inference.infer_dataloader import get_inference_dataloader; assert importlib.util.find_spec('cuequivariance_ops_torch'); print('torch', torch.__version__, 'cuda', torch.version.cuda); print('protenix cli', protenix_cli.name)" \
 && find /opt/conda/envs/protenix -type d -name "__pycache__" -prune -exec rm -rf {} + \
 && find /opt/conda/envs/protenix -type f \( -name "*.pyc" -o -name "*.pyo" \) -delete

WORKDIR /workspace
